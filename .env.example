# LinkHub Supabase Database Configuration
# Create a free project at https://supabase.com
# Go to Project Settings -> API, then copy your Project URL and Anon/Public Key:

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note: If these variables are left empty or not provided,
# the app will automatically use local storage so it never crashes!
