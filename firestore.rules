rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /websites/{websiteId} {
      allow read, write: if true;
    }
    match /categories/{categoryId} {
      allow read, write: if true;
    }
    match /user_favorites/{favoriteId} {
      allow read, write: if true;
    }
    match /submissions/{submissionId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
